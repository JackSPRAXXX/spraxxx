# ===== SPRAXXX Blackbox Landing - Git Ignore =====

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# Environment Files (NEVER commit credentials)
.env
.env.local
.env.*.local
credentials.json
secrets.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# Dependency Directories
node_modules/
jspm_packages/

# Build Outputs (if using build tools later)
dist/
build/
*.min.js
*.min.css

# Temporary Files
tmp/
temp/
*.tmp

# Backup Files
*.bak
*.backup
*~.nib

# Test Coverage
coverage/
.nyc_output/

